MIN_EVENTS_FOR_MODEL=5000       # lower to 100 for local testing
TWO_TOWER_RETRAIN_INTERVAL_HOURS=6   # lower to 0.1 for local testing
VIDEO_STORAGE_PATH=/app/storage/videos
MODEL_STORAGE_PATH=/app/storage/models
# CORS Security Fix: comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://myapp.com
# Database Connection Pool: Configure for your concurrent user load
DB_POOL_SIZE=20      # Number of persistent connections
DB_POOL_OVERFLOW=40  # Additional connections allowed when pool exhausted
